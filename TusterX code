local function ApplyTheme(themeName)
    CurrentTheme = themeName
    local T = Themes[themeName]

    TweenService:Create(Main, TweenInfo.new(0.3), {BackgroundColor3 = T.Background}):Play()
    TweenService:Create(MainStroke, TweenInfo.new(0.3), {Color = T.Stroke}):Play()
    TweenService:Create(Header, TweenInfo.new(0.3), {BackgroundColor3 = T.Header}):Play()
    TweenService:Create(HeaderFix, TweenInfo.new(0.3), {BackgroundColor3 = T.Header}):Play()
    TweenService:Create(Title, TweenInfo.new(0.3), {TextColor3 = T.Accent}):Play()

    TweenService:Create(ThemeBtn, TweenInfo.new(0.3), {
        BackgroundColor3 = T.Element,
        TextColor3 = T.Text
    }):Play()
    TweenService:Create(ThemeStroke, TweenInfo.new(0.3), {Color = T.Stroke}):Play()

    ThemeBtn.Text = themeName == "Dark" and "DARK MODE" or "LIGHT MODE"

    for _, mod in pairs(Content:GetChildren()) do
        if mod:IsA("Frame") then
            TweenService:Create(mod, TweenInfo.new(0.3), {BackgroundColor3 = T.Element}):Play()
            for _, child in pairs(mod:GetChildren()) do
                if child:IsA("UIStroke") then
                    TweenService:Create(child, TweenInfo.new(0.3), {Color = T.Stroke}):Play()
                elseif child:IsA("TextLabel") and child.Name == "ModuleTitle" then
                    TweenService:Create(child, TweenInfo.new(0.3), {TextColor3 = T.Text}):Play()
                elseif child:IsA("TextBox") then
                    TweenService:Create(child, TweenInfo.new(0.3), {
                        BackgroundColor3 = T.Background,
                        TextColor3 = T.Text,
                        PlaceholderColor3 = T.SubText
                    }):Play()
                    for _, s in pairs(child:GetChildren()) do
                        if s:IsA("UIStroke") then
                            TweenService:Create(s, TweenInfo.new(0.3), {Color = T.Stroke}):Play()
                        end
                    end
                elseif child:IsA("TextButton") and child.Name == "Toggle" then
                    local circle = child:FindFirstChild("Circle")
                    if circle and circle.Position.X.Scale < 0.5 then
                        TweenService:Create(child, TweenInfo.new(0.3), {BackgroundColor3 = T.Stroke}):Play()
                    end
                end
            end
        end
    end
end

ThemeBtn.MouseButton1Click:Connect(function()
