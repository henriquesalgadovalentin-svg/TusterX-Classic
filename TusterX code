local function createToggle(parent)
    local Toggle = Instance.new("TextButton")
    Toggle.Name = "Toggle"
    Toggle.Size = UDim2.new(0, 48, 0, 24)
    Toggle.Position = UDim2.new(1, -60, 0.5, -12)
    Toggle.BackgroundColor3 = Themes[CurrentTheme].Stroke
    Toggle.Text = ""
    Toggle.AutoButtonColor = false
    Toggle.Parent = parent

    local tCorner = Instance.new("UICorner")
    tCorner.CornerRadius = UDim.new(1, 0)
    tCorner.Parent = Toggle

    local Circle = Instance.new("Frame")
    Circle.Name = "Circle"
    Circle.Size = UDim2.new(0, 18, 0, 18)
    Circle.Position = UDim2.new(0, 3, 0.5, -9)
    Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Circle.Parent = Toggle

    local cCorner = Instance.new("UICorner")
    cCorner.CornerRadius = UDim.new(1, 0)
    cCorner.Parent = Circle

    local state = false
    local callbacks = {}

    Toggle.MouseButton1Click:Connect(function()
        state = not state
        if state then
            TweenService:Create(Toggle, TweenInfo.new(0.2), {BackgroundColor3 = Themes[CurrentTheme].Accent}):Play()
            TweenService:Create(Circle, TweenInfo.new(0.2), {Position = UDim2.new(1, -21, 0.5, -9)}):Play()
        else
            TweenService:Create(Toggle, TweenInfo.new(0.2), {BackgroundColor3 = Themes[CurrentTheme].Stroke}):Play()
            TweenService:Create(Circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -9)}):Play()
        end
        for _, cb in pairs(callbacks) do cb(state) end
    end)

    return Toggle, function() return state end, function(cb) table.insert(callbacks, cb) end
end

