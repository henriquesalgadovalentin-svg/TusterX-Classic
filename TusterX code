local function removeESPForPlayer(plr)
    if ESPObjects[plr] then
        for _, obj in pairs(ESPObjects[plr]) do
            if obj and obj.Destroy then obj:Destroy() end
        end
        ESPObjects[plr] = nil
    end
end

local function clearAllESP()
    for plr, _ in pairs(ESPObjects) do
        removeESPForPlayer(plr)
    end
end

RunService.RenderStepped:Connect(function()
    if not ESPEnabled then return end
    for plr, data in pairs(ESPObjects) do
        if plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and root then
                local hp = math.floor(hum.Health)
                data.healthLabel.Text = hp .. " HP"
                if hp > 70 then
                    data.healthLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                elseif hp > 30 then
                    data.healthLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
                else
                    data.healthLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                end

                local localChar = LocalPlayer.Character
                local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
                if localRoot then
                    local dist = math.floor((root.Position - localRoot.Position).Magnitude)
                    data.distanceLabel.Text = dist .. " studs"
                end

                data.highlight.Adornee = plr.Character
                data.billboard.Adornee = plr.Character
            end
        end
    end
end)

onEspChange(function(state)
    ESPEnabled = state
    if state then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                createESPForPlayer(plr)
            end
        end
    else
        clearAllESP()
    end
end)

Players.PlayerAdded:Connect(function(plr)
