-- ============================================
-- FLY (usa controles nativos do Roblox)
-- ============================================
local FlyEnabled = false
local FlyConnection = nil
local FlyBodyVelocity = nil
local FlyBodyGyro = nil
local FlySpeed = 60

-- Atualiza velocidade pelo TextBox
FlyBox.FocusLost:Connect(function()
    local num = tonumber(FlyBox.Text)
    if num then
        FlySpeed = num
    end
end)

local function getMoveVectorFromHumanoid(hum)
    -- MoveDirection do Humanoid já vem dos controles nativos (WASD / joystick)
    return hum.MoveDirection
end

local function startFly()
    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    FlyBodyVelocity = Instance.new("BodyVelocity")
    FlyBodyVelocity.Name = "TusterX_FlyVelocity"
    FlyBodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    FlyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    FlyBodyVelocity.Parent = hrp

    FlyBodyGyro = Instance.new("BodyGyro")
    FlyBodyGyro.Name = "TusterX_FlyGyro"
    FlyBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    FlyBodyGyro.P = 1000
    FlyBodyGyro.D = 50
    FlyBodyGyro.CFrame = hrp.CFrame
    FlyBodyGyro.Parent = hrp

    hum.PlatformStand = true

    FlyConnection = RunService.RenderStepped:Connect(function()
        if not hrp.Parent or not FlyBodyVelocity or not FlyBodyGyro then return end
        if not LocalPlayer.Character then return end

        local cam = workspace.CurrentCamera
        local currentHum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not currentHum then return end

        -- Pega direção de movimento do Humanoid (nativo: WASD / joystick mobile)
        local moveDir = currentHum.MoveDirection

        -- Converte direção da câmera (frente/trás/lados)
        local look = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector

        local velocity = Vector3.new(0, 0, 0)

        if moveDir.Magnitude > 0 then
            -- moveDir está no espaço do mundo, projetar nos eixos da câmera
            local flatLook = Vector3.new(look.X, 0, look.Z).Unit
            local flatRight = Vector3.new(right.X, 0, right.Z).Unit

            local forward = moveDir:Dot(flatLook)
            local side = moveDir:Dot(flatRight)

            velocity = (flatLook * forward + flatRight * side).Unit * FlySpeed
        end

        -- Subir/descer com os botões nativos
        if currentHum.Jump then
            velocity = velocity + Vector3.new(0, FlySpeed, 0)
        end

        -- Roblox nativo não tem "descer" por padrão.
        -- Se quiser descer, segure Ctrl (PC) ou use botão do jump enquanto olha pra baixo.
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
            velocity = velocity - Vector3.new(0, FlySpeed, 0)
        end

        FlyBodyVelocity.Velocity = velocity
        FlyBodyGyro.CFrame = cam.CFrame
    end)
end

local function stopFly()
    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end
    if FlyBodyVelocity then
        FlyBodyVelocity:Destroy()
        FlyBodyVelocity = nil
    end
    if FlyBodyGyro then
        FlyBodyGyro:Destroy()
        FlyBodyGyro = nil
    end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

onFlyChange(function(state)
    FlyEnabled = state
    if state then
        startFly()
    else
        stopFly()
    end
end)

